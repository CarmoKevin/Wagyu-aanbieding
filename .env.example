# Optioneel: zet de AI-agent aan (samenvatting + shops ontdekken via /api/agent).
ANTHROPIC_API_KEY=
# Optioneel: ander model voor de agent (standaard claude-opus-5).
WAGYU_AGENT_MODEL=

# Optioneel: prijshistorie bewaren zodat "echte" korting berekend kan worden
# ook bij shops die geen van-prijs publiceren. Vercel KV / Upstash Redis.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel vult dit zelf; beschermt /api/cron/refresh tegen misbruik.
CRON_SECRET=

# Scanner-instellingen. Laat ze weg als je de standaard wilt; een lege waarde
# telt als "niet gezet" en valt terug op de standaard hieronder.
DEALS_TTL_MINUTES=180
FETCH_TIMEOUT_MS=12000
# Tijdsbudget per shop; voorkomt dat één trage shop de hele scan ophoudt.
SHOP_BUDGET_MS=25000
SCRAPER_USER_AGENT=
